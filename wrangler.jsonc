{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "shajara",
  "main": "src/worker.js",
  "compatibility_date": "2025-10-01",
  "assets": { "directory": "./public", "binding": "ASSETS" },
  // Baza birinchi deployda avtomatik yaratiladi (wrangler >= 4.45).
  "d1_databases": [{ "binding": "DB", "database_name": "shajara-db","database_id": "d2a57d28-b977-4775-9549-10e8c9c302a1" }],
  "observability": { "enabled": true }
}
